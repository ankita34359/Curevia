# Copy to .env for local work. Never commit .env. On Embarko these go on the secrets page.
PORT=3000
# Only this folder persists on Embarko. Locally defaults to ./data
DATA_DIR=./data
# Public address of the site, no trailing slash (used in email links)
APP_URL=http://localhost:3000

# Admin account (created / kept in sync on every start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Long random string used to sign login cookies (at least 16 characters)
SESSION_SECRET=replace-with-a-long-random-string

# viaSocket
VIASOCKET_ORG_ID=80141
VIASOCKET_PROJECT_ID=projKcrymrh3
VIASOCKET_EMBED_SECRET=
VIASOCKET_UNIQUE_ID=curevia-hospital

# Created by Embarko; protects POST /api/cron/tick
CRON_SECRET=
