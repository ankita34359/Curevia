# Copy to .env for local work. NEVER commit .env. On Embarko these go on the app's secrets page.

# --- set by Embarko (do not set there) -------------------------------------------------------------
# PORT         the app listens on it, on 0.0.0.0 (local default 3000)
# DATA_DIR     the only folder that survives a redeploy; the SQLite file lives here (local default ./data)
# CRON_SECRET  protects /api/cron/tick; Embarko creates it for apps with a schedule

# --- required ----------------------------------------------------------------------------------------
# Set NODE_ENV=production on Embarko only (the local seed script refuses to run with it).
# NODE_ENV=production
# Public address of the site, no trailing slash. Used in email links and for the secure cookie flag.
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Long random string (16+ characters) that signs the login cookie
SESSION_SECRET=replace-with-a-long-random-string

# --- viaSocket (emails, Google Sheet, Slack, AI agent) ----------------------------------------------
VIASOCKET_ORG_ID=80141
VIASOCKET_PROJECT_ID=projKcrymrh3
VIASOCKET_UNIQUE_ID=curevia-hospital
# The signing secret from viaSocket -> Integrations -> the embed -> Install Code. Server only.
VIASOCKET_EMBED_SECRET=

# --- optional ----------------------------------------------------------------------------------------
# AI model for the agent (viaSocket AI API). Defaults shown.
AGENT_SERVICE=openai
AGENT_MODEL=gpt-5-mini
# Demo timing for showing the agent live (OFF when empty). A number 1-120: the 2-hour mark becomes that many minutes
# (2 = remind the doctor after 2 min, alert the admin after 6 min). Real emails/Slack still go out. Turn off after the demo.
AGENT_DEMO_MINUTES=
# Number of proxies in front of the app (for the real visitor IP in the login rate limit). Default 1.
TRUST_PROXY=1
# For local testing only: CRON_SECRET=any-long-string lets you call the tick yourself
CRON_SECRET=
